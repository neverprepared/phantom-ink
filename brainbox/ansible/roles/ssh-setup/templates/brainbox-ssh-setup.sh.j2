#!/bin/bash
set -euo pipefail

USER="{{ developer_user }}"
AUTH_KEYS="/Users/${USER}/.ssh/authorized_keys"
SHARED_BASE="/Volumes/My Shared Files"

# Method 1: VirtioFS .ssh share (template-level, from UTM GUI)
SSH_SHARE="${SHARED_BASE}/.ssh"
if [ -d "$SSH_SHARE" ]; then
    PUB_KEY="${SSH_SHARE}/id_ed25519.pub"
    if [ -f "$PUB_KEY" ]; then
        mkdir -p "/Users/${USER}/.ssh"
        chmod 700 "/Users/${USER}/.ssh"
        cp "$PUB_KEY" "$AUTH_KEYS"
        chown "${USER}:staff" "$AUTH_KEYS"
        chmod 600 "$AUTH_KEYS"
        echo "brainbox-ssh: authorized_keys updated from .ssh share"
        exit 0
    fi
fi

# Method 2: MAC-scoped brainbox session dir (clone-level, from backend)
BRAINBOX_SHARE="/Volumes/brainbox"
if [ -d "$BRAINBOX_SHARE/sessions" ]; then
    # Find the first session dir containing authorized_keys
    for dir in "$BRAINBOX_SHARE/sessions"/*/; do
        if [ -f "${dir}authorized_keys" ]; then
            mkdir -p "/Users/${USER}/.ssh"
            chmod 700 "/Users/${USER}/.ssh"
            cp "${dir}authorized_keys" "$AUTH_KEYS"
            chown "${USER}:staff" "$AUTH_KEYS"
            chmod 600 "$AUTH_KEYS"
            echo "brainbox-ssh: authorized_keys updated from session dir"
            exit 0
        fi
    done
fi

echo "brainbox-ssh: no SSH key source found (non-brainbox boot, skipping)"
