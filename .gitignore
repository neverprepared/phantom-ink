# Compose .env files — they carry MINIO_ROOT_PASSWORD and similar
# bootstrap secrets that must never be committed.
docker/**/.env

# Local Docker volume data (postgres/qdrant/minio/opensearch runtime state) —
# runtime, not source; regenerated on `docker compose up`. Never track.
docker/volumes/

# Worker task output (ratchet review/fix artifacts)
tasks/
