# MinIO Configuration
# Copy to .env and set strong credentials before starting.
#
# These are the ROOT credentials — used only for bootstrap. Per-profile
# IAM keys are created on top via ./bootstrap-buckets.sh; brainbox
# daemons + the app never see these root creds at runtime.

MINIO_ROOT_USER=<choose-a-username>
MINIO_ROOT_PASSWORD=<choose-a-strong-password>
