{
  "version": 1,
  "servers": {
    "atlassian": {
      "description": "Jira and Confluence integration",
      "category": "collaboration",
      "url": "https://github.com/sooperset/mcp-atlassian",
      "requires": ["JIRA_URL", "JIRA_USERNAME", "JIRA_API_TOKEN"],
      "definition": {
        "command": "uvx",
        "args": ["--python", "3.12", "mcp-atlassian==0.13.0"],
        "env": {
          "JIRA_URL": "${JIRA_URL}",
          "JIRA_USERNAME": "${JIRA_USERNAME}",
          "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
          "CONFLUENCE_URL": "${CONFLUENCE_URL}",
          "CONFLUENCE_USERNAME": "${CONFLUENCE_USERNAME}",
          "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
        }
      }
    },
    "git": {
      "description": "Git repository operations",
      "category": "development",
      "url": "https://github.com/modelcontextprotocol/servers",
      "requires": [],
      "definition": {
        "command": "uvx",
        "args": ["mcp-server-git==2025.12.18", "--repository", "."],
        "env": {}
      }
    },
    "github": {
      "description": "GitHub repos, issues, PRs, and code security",
      "category": "development",
      "url": "https://github.com/github/github-mcp-server",
      "requires": ["GITHUB_TOKEN"],
      "definition": {
        "command": "docker",
        "args": [
          "run", "-i", "--rm",
          "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
          "-e", "GITHUB_TOOLSETS",
          "ghcr.io/github/github-mcp-server"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}",
          "GITHUB_TOOLSETS": "repos,issues,pull_requests,code_security"
        }
      }
    },
    "microsoft-docs": {
      "description": "Microsoft Learn documentation search",
      "category": "docs",
      "url": "https://github.com/MicrosoftDocs/mcp",
      "requires": [],
      "definition": {
        "command": "npx",
        "args": ["-y", "mcp-remote@0.1.37", "https://mcp.microsoft-learn.com/api/mcp/sse"]
      }
    },
    "azure": {
      "description": "Azure resource management",
      "category": "cloud",
      "url": "https://github.com/microsoft/mcp",
      "requires": ["AZURE_SUBSCRIPTION_ID", "AZURE_TENANT_ID", "AZURE_CLIENT_ID", "AZURE_CLIENT_SECRET"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@azure/mcp@2.0.0-beta.10", "server", "start"],
        "env": {
          "AZURE_SUBSCRIPTION_ID": "${AZURE_SUBSCRIPTION_ID}",
          "AZURE_TENANT_ID": "${AZURE_TENANT_ID}",
          "AZURE_CLIENT_ID": "${AZURE_CLIENT_ID}",
          "AZURE_CLIENT_SECRET": "${AZURE_CLIENT_SECRET}"
        }
      }
    },
    "azure-devops": {
      "description": "Azure DevOps CI/CD and repos",
      "category": "cloud",
      "url": "https://github.com/microsoft/azure-devops-mcp",
      "requires": ["AZURE_DEVOPS_ORG", "AZURE_DEVOPS_PAT"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@azure-devops/mcp@2.2.2"],
        "env": {
          "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/${AZURE_DEVOPS_ORG}",
          "AZURE_DEVOPS_PAT": "${AZURE_DEVOPS_PAT}"
        }
      }
    },
    "markitdown": {
      "description": "Convert files to markdown",
      "category": "docs",
      "url": "https://github.com/microsoft/markitdown",
      "requires": [],
      "definition": {
        "command": "uvx",
        "args": ["markitdown-mcp"]
      }
    },
    "sql-server": {
      "description": "Microsoft SQL Server queries",
      "category": "database",
      "url": "https://github.com/bymcs/mssql-mcp",
      "requires": ["MSSQL_CONNECTION_STRING"],
      "definition": {
        "command": "npx",
        "args": ["-y", "mssql-mcp@2.1.1"],
        "env": {
          "MSSQL_CONNECTION_STRING": "${MSSQL_CONNECTION_STRING}"
        }
      }
    },
    "playwright": {
      "description": "Browser automation and testing",
      "category": "development",
      "url": "https://github.com/microsoft/playwright-mcp",
      "requires": [],
      "definition": {
        "command": "npx",
        "args": ["-y", "@playwright/mcp@0.0.55"],
        "env": {}
      }
    },
    "devbox": {
      "description": "Microsoft Dev Box management",
      "category": "cloud",
      "url": "https://github.com/microsoft/devbox-mcp-server",
      "requires": ["AZURE_SUBSCRIPTION_ID", "AZURE_TENANT_ID"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@microsoft/devbox-mcp@0.0.3-alpha.4"],
        "env": {
          "AZURE_SUBSCRIPTION_ID": "${AZURE_SUBSCRIPTION_ID}",
          "AZURE_TENANT_ID": "${AZURE_TENANT_ID}"
        }
      }
    },
    "azure-ai-foundry": {
      "description": "Azure AI Foundry models and services",
      "category": "cloud",
      "url": "https://github.com/azure-ai-foundry/mcp-foundry",
      "requires": ["AZURE_TENANT_ID"],
      "definition": {
        "command": "npx",
        "args": ["-y", "mcp-remote@0.1.37", "https://mcp.ai.azure.com"],
        "env": {
          "AZURE_TENANT_ID": "${AZURE_TENANT_ID}"
        }
      }
    },
    "kubernetes": {
      "description": "Kubernetes cluster operations",
      "category": "cloud",
      "url": "https://github.com/containers/kubernetes-mcp-server",
      "requires": [],
      "definition": {
        "command": "npx",
        "args": ["-y", "kubernetes-mcp-server@0.0.56", "--disable-destructive"],
        "env": {
          "KUBECONFIG": "${KUBECONFIG:-~/.kube/config}"
        }
      }
    },
    "spacelift": {
      "description": "Spacelift IaC management and deployment",
      "category": "cloud",
      "url": "https://github.com/spacelift-io/spacectl",
      "requires": [],
      "definition": {
        "command": "spacectl",
        "args": ["mcp", "server"]
      }
    },
    "google-workspace": {
      "description": "Gmail, Calendar, Drive, Docs, Sheets",
      "category": "collaboration",
      "url": "https://github.com/taylorwilsdon/google_workspace_mcp",
      "requires": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "USER_GOOGLE_EMAIL"],
      "definition": {
        "command": "uvx",
        "args": ["--python", "3.12", "workspace-mcp==1.7.1", "--tool-tier", "core"],
        "env": {
          "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
          "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
          "USER_GOOGLE_EMAIL": "${USER_GOOGLE_EMAIL}"
        }
      },
      "container_definition": {
        "command": "workspace-mcp",
        "args": ["--tool-tier", "core"],
        "env": {
          "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
          "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
          "USER_GOOGLE_EMAIL": "${USER_GOOGLE_EMAIL}"
        }
      }
    },
    "brainbox": {
      "description": "PhantomInk platform — sandboxed sessions, hub tasks, playbooks, git worktrees, channels, repos, and artifacts",
      "category": "development",
      "url": "https://github.com/neverprepared/ink-bunny",
      "requires": [],
      "definition": {
        "command": "uvx",
        "args": [
          "--from", "git+https://github.com/neverprepared/ink-bunny#subdirectory=brainbox",
          "--extra", "mcp",
          "brainbox",
          "mcp"
        ],
        "env": {
          "BRAINBOX_URL": "${BRAINBOX_URL:-http://127.0.0.1:9999}"
        }
      },
      "container_definition": {
        "command": "brainbox-mcp",
        "args": [],
        "env": {
          "BRAINBOX_URL": "${BRAINBOX_URL:-http://host.docker.internal:9999}"
        }
      }
    },
    "cloudflare-dns": {
      "description": "Cloudflare DNS record management — list, create, update, delete DNS records",
      "category": "cloud",
      "url": "https://github.com/neverprepared/mcp-cloudflare-dns",
      "requires": ["CLOUDFLARE_API_TOKEN"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@neverprepared/mcp-cloudflare-dns"],
        "env": {
          "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
        }
      },
      "container_definition": {
        "command": "mcp-cloudflare",
        "args": [],
        "env": {
          "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
        }
      }
    },
    "uptime-kuma": {
      "description": "Uptime Kuma v2 monitoring — monitors, notifications, tags, status pages, and maintenance",
      "category": "observability",
      "url": "https://github.com/neverprepared/mcp-uptime-kuma",
      "requires": ["UPTIME_KUMA_URL", "UPTIME_KUMA_USERNAME", "UPTIME_KUMA_PASSWORD"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@neverprepared/mcp-uptime-kuma"],
        "env": {
          "UPTIME_KUMA_URL": "${UPTIME_KUMA_URL:-http://localhost:3001}",
          "UPTIME_KUMA_USERNAME": "${UPTIME_KUMA_USERNAME}",
          "UPTIME_KUMA_PASSWORD": "${UPTIME_KUMA_PASSWORD}",
          "UPTIME_KUMA_TOKEN": "${UPTIME_KUMA_TOKEN}",
          "UPTIME_KUMA_MFA_TOKEN": "${UPTIME_KUMA_MFA_TOKEN}"
        }
      },
      "container_definition": {
        "command": "mcp-uptime-kuma",
        "args": [],
        "env": {
          "UPTIME_KUMA_URL": "${UPTIME_KUMA_URL:-http://localhost:3001}",
          "UPTIME_KUMA_USERNAME": "${UPTIME_KUMA_USERNAME}",
          "UPTIME_KUMA_PASSWORD": "${UPTIME_KUMA_PASSWORD}",
          "UPTIME_KUMA_TOKEN": "${UPTIME_KUMA_TOKEN}",
          "UPTIME_KUMA_MFA_TOKEN": "${UPTIME_KUMA_MFA_TOKEN}"
        }
      }
    },
    "new-relic": {
      "description": "New Relic observability — NerdGraph GraphQL API for metrics, alerts, and entity management",
      "category": "observability",
      "url": "https://github.com/neverprepared/mcp-new-relic",
      "requires": ["NEW_RELIC_API_KEY"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@neverprepared/mcp-new-relic"],
        "env": {
          "NEW_RELIC_API_KEY": "${NEW_RELIC_API_KEY}"
        }
      }
    },
    "az-pim": {
      "description": "Azure Privileged Identity Management — activate and manage PIM role assignments",
      "category": "cloud",
      "url": "https://github.com/neverprepared/az-pim-cli",
      "requires": [],
      "definition": {
        "command": "az-pim-cli",
        "args": ["mcp"]
      }
    },
    "argocd": {
      "description": "Argo CD application management — list, sync, and inspect applications and resources",
      "category": "cloud",
      "url": "https://github.com/argoproj-labs/mcp-for-argocd",
      "requires": ["ARGOCD_BASE_URL", "ARGOCD_API_TOKEN"],
      "definition": {
        "command": "npx",
        "args": ["-y", "argocd-mcp@0.5.0", "stdio"],
        "env": {
          "ARGOCD_BASE_URL": "${ARGOCD_BASE_URL}",
          "ARGOCD_API_TOKEN": "${ARGOCD_API_TOKEN}"
        }
      }
    },
    "macos-ecosystem": {
      "description": "macOS Reminders, Calendar, and Notes — create, list, search, and manage tasks and events via native macOS apps",
      "category": "macos",
      "url": "https://github.com/neverprepared/macos-ecosystem-mcp",
      "requires": [],
      "definition": {
        "command": "macos-ecosystem-mcp",
        "args": []
      }
    },
    "markdown-to-confluence": {
      "description": "Publish Markdown documents to Confluence — converts to ADF, renders Mermaid diagrams as attachments",
      "category": "docs",
      "url": "https://github.com/neverprepared/mcp-markdown-to-confluence",
      "requires": ["CONFLUENCE_BASE_URL", "CONFLUENCE_EMAIL", "CONFLUENCE_API_TOKEN"],
      "definition": {
        "command": "npx",
        "args": ["-y", "@neverprepared/mcp-markdown-to-confluence@1.0.1"],
        "env": {
          "CONFLUENCE_BASE_URL": "${CONFLUENCE_BASE_URL}",
          "CONFLUENCE_EMAIL": "${CONFLUENCE_EMAIL}",
          "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
        }
      },
      "container_definition": {
        "command": "mcp-markdown-to-confluence",
        "args": [],
        "env": {
          "CONFLUENCE_BASE_URL": "${CONFLUENCE_BASE_URL}",
          "CONFLUENCE_EMAIL": "${CONFLUENCE_EMAIL}",
          "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
        }
      }
    },
    "grafana": {
      "description": "Grafana dashboards, datasources, alerts, and Loki/Prometheus queries",
      "category": "observability",
      "url": "https://github.com/grafana/mcp-grafana",
      "requires": ["GRAFANA_URL", "GRAFANA_API_KEY"],
      "definition": {
        "command": "docker",
        "args": [
          "run", "-i", "--rm",
          "-e", "GRAFANA_URL",
          "-e", "GRAFANA_API_KEY",
          "grafana/mcp-grafana:latest"
        ],
        "env": {
          "GRAFANA_URL": "${GRAFANA_URL:-http://localhost:3000}",
          "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
        }
      }
    },
    "utm": {
      "description": "UTM virtual machine management — clone, configure, start/stop, network, shares, and drives via AppleScript",
      "category": "macos",
      "url": "https://github.com/neverprepared/mcp-utm",
      "requires": [],
      "definition": {
        "command": "uvx",
        "args": ["mcp-utm"],
        "env": {}
      }
    },
    "obsidian-second-brain": {
      "description": "Obsidian second brain — read and search notes from a local vault using the PARA method",
      "category": "knowledge",
      "url": "https://github.com/neverprepared/mcp-obsidian-second-brain",
      "requires": ["OBSIDIAN_VAULT_PATH"],
      "definition": {
        "command": "mcp-obsidian-second-brain",
        "args": [],
        "env": {
          "OBSIDIAN_VAULT_PATH": "${OBSIDIAN_VAULT_PATH}",
          "LOG_LEVEL": "${LOG_LEVEL:-info}"
        }
      }
    }
  }
}
